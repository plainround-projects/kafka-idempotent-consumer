# Copy to .env (make up does it the first time). Values are for a database that lives only on this
# machine while the containers run; change the password if you share the machine.
BOOTSTRAP_SERVERS=localhost:9092
TOPIC=payments
DLQ_TOPIC=payments-dlq
GROUP_ID=balance-updater

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Kafka client timeouts, in milliseconds.
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_RETRY_BACKOFF_MS=100
